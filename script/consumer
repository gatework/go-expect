#!/usr/bin/env bash
set -euo pipefail
repo_root=$(cd "$(dirname "$0")/.." && pwd)
consumer_dir=$(mktemp -d "${TMPDIR:-/tmp}/go-expect-consumer.XXXXXX")
trap 'rm -rf "$consumer_dir"' EXIT
cp "$repo_root/testdata/consumer/main.go" "$consumer_dir/main.go"
cd "$consumer_dir"
go mod init consumer.example/smoke
go mod edit -replace "github.com/gatework/go-expect=$repo_root"
go mod tidy
go run .
